{
  "name": "@riftbound/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "APP_VARIANT=development expo start --dev-client --port 7001",
    "start": "APP_VARIANT=development expo start --dev-client --port 7001",
    "android": "APP_VARIANT=development expo start --android --dev-client --port 7001",
    "ios": "APP_VARIANT=development expo start --ios --dev-client --port 7001",
    "web": "expo start --web --port 7001",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "uniwind:types": "uniwind generate-artifacts --css ./global.css --dts ./uniwind-types.d.ts",
    "test": "bun test --isolate --path-ignore-patterns 'e2e/**'",
    "test:ui-e2e": "playwright test",
    "test:ui-e2e:headed": "playwright test --headed",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "eas-build-post-install": "bun run --cwd ../../packages/contracts build"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.23",
    "@blobatar/react-native": "^2.5.0",
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~57.0.10",
    "@expo/ui": "~57.0.11",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@piltoverarchive/riftbound-deck-codes": "^1.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@riftbound/contracts": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "better-auth": "^1.6.23",
    "blobatar": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "expo": "~57.0.13",
    "expo-asset": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "markdown-it": "^14.3.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sonner": "^2.0.7",
    "sonner-native": "^0.26.4",
    "uniwind": "^1.10.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "~19.2.4",
    "eslint": "^9.28.0",
    "eslint-config-expo": "~57.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.3"
  }
