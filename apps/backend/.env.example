NODE_ENV=development
PORT=7000
# HOST=::
# Local Postgres: start from the repo root with `bun run db` (or `bun run db -d`).
DATABASE_URL=postgres://riftbound:riftbound@localhost:5433/riftbound
# Optional: e2e tests use this instead of DATABASE_URL when set.
TEST_DB_URL=postgres://riftbound:riftbound@localhost:5433/riftbound_test
PA_API_KEY=ak_your_key_here
PA_BASE_URL=https://piltoverarchive.com/api/external
ADMIN_SYNC_TOKEN=dev-sync-token-change-me

# Owned decks are local and private; the shared PA key is used for reads only.
# Global per-process PA request budget (includes background sync):
# UPSTREAM_REQUESTS_PER_MINUTE=600
# PA author name of the shared-key account; its decks never appear as community decks.
# UPSTREAM_SERVICE_AUTHOR=

# Cardmarket daily price guide export — Riftbound idGame is 22
CARDMARKET_GAME_ID=22
# Raw price_history retention (charts use price_daily). POST /api/v1/sync/prices prunes after every sync.
# PRICE_HISTORY_RETAIN_DAYS=90
# PRICE_HISTORY_RETAIN_SNAPSHOTS=30

# Better Auth (generate secret: openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-in-production
# Local dev:
BETTER_AUTH_URL=http://localhost:7000
# Railway (backend service) — resolved from each service's public domain:
# BETTER_AUTH_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# TRUSTED_ORIGINS=https://${{RAILWAY_SERVICE_EXPO_WEB_URL}}
# Cookies are host-only by default. Only set AUTH_COOKIE_DOMAIN for an explicitly owned host.
# Required in production: trust forwarding headers only from verified ingress proxy networks.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Local Expo web (invite + verify + password-reset links in emails):
# PUBLIC_APP_URL=http://localhost:7001
# When BETTER_AUTH_URL is a public host and this is unset, emails use that origin
# instead of localhost. Set explicitly for remote/dev hosts:
# PUBLIC_APP_URL=https://riftbounddev.roan.dev
# Production Expo web origin used for shareable HTTPS invites:
# PUBLIC_APP_URL=https://${{RAILWAY_SERVICE_EXPO_WEB_URL}}
# Or fixed host:
# PUBLIC_APP_URL=https://rift.solace.onl

# Cloudflare R2 image cache (EU jurisdiction endpoint)
# Create S3 API credentials in Cloudflare dashboard → R2 → Manage R2 API tokens
S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=riftbound
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Internal releases use a separate private bucket and credentials.
# Configure all four required settings together; the backend needs read access only.
# RELEASE_S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# RELEASE_S3_REGION=auto
# RELEASE_S3_BUCKET=astral-releases
# RELEASE_S3_ACCESS_KEY_ID=read-only-release-access-key
# RELEASE_S3_SECRET_ACCESS_KEY=read-only-release-secret
# RELEASE_LINK_SECRET=independent-random-signing-secret
# Optional, temporary: validates previously distributed links during key migration.
# RELEASE_LINK_LEGACY_SECRET=previous-link-signing-secret

# Stalwart transactional mail (optional — verification + password reset)
# Sends over JMAP HTTPS to the VPS edge (HAProxy :443). Do not use SMTP from
# Railway Hobby — outbound 25/465/587 are blocked; Stalwart already relays
# outbound via the VPS Postfix path.
# Create a dedicated mailbox + identity in Stalwart (e.g. noreply@solace.onl).
# STALWART_JMAP_URL=https://mail.solace.onl
# STALWART_JMAP_USERNAME=noreply@solace.onl
# STALWART_JMAP_PASSWORD=
# EMAIL_FROM=noreply@solace.onl
# EMAIL_FROM_NAME=The Astral Grove
# DB_POOL_MAX=10
# CATALOG_WARMUP_ON_START=false

# --- Cloudflare Tunnel (run separately: `bun run cloudflared`) ---
# https://riftbounddev.roan.dev → API :7000 only; Expo/Metro stays on loopback.
# Local credentials-file tunnels use generated restricted ingress; remote tunnel tokens are refused.
# See cloudflared/config.example.yml
