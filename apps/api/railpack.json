{
  "$schema": "https://schema.railpack.com",
  "provider": "rust",
  "packages": { "rust": "1.98.1" },
  "steps": {
    "build": {
      "commands": [
        "cargo build --locked --release --package astral-grove-server --bin astral-grove-server"
      ]
    }
  },
  "deploy": { "startCommand": "./target/release/astral-grove-server" }
}
