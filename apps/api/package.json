{
  "name": "@riftbound/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "bun scripts/reset-db.ts --local",
    "db:reset:full": "bun scripts/reset-db.ts --local --catalog --prices",
    "db:studio": "drizzle-kit studio",
    "sync:prices": "bun scripts/sync-cardmarket-prices.ts",
    "audit:cards": "bun scripts/audit-cards-upstream.ts",
    "test": "bun scripts/run-tests.ts",
    "test:unit": "bun test test/unit --coverage",
    "test:coverage": "bun test test/unit test/e2e --coverage --preload ./test/e2e/preload.ts --max-concurrency=1"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@better-auth/expo": "^1.6.23",
    "@elysia/compress": "2.0.0-beta.2",
    "@elysia/cors": "next",
    "@riftbound/contracts": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "elysia": "next",
    "postgres": "^3.4.7",
    "sharp": "^0.35.3",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@riftbound/typescript-config": "workspace:*",
    "@types/bun": "^1.2.15",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
