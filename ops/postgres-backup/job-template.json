{
  "activeDeadlineSeconds": 900,
  "backoffLimit": 1,
  "template": {
    "metadata": {
      "labels": {
        "app.kubernetes.io/name": "postgres-backup"
      }
    },
    "spec": {
      "automountServiceAccountToken": false,
      "restartPolicy": "Never",
      "securityContext": {
        "runAsNonRoot": true,
        "runAsUser": 999,
        "runAsGroup": 999,
        "fsGroup": 999,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "containers": [
        {
          "name": "backup",
          "image": "localhost/astral-grove-postgres-backup:20261010",
          "imagePullPolicy": "Never",
          "command": ["python3", "/scripts/backup.py"],
          "envFrom": [
            {
              "secretRef": {
                "name": "postgres-backup-s3"
              }
            }
          ],
          "env": [
            {
              "name": "VPS_DB_URL",
              "valueFrom": {
                "secretKeyRef": {
                  "name": "postgres-env",
                  "key": "DATABASE_URL"
                }
              }
            }
          ],
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "readOnlyRootFilesystem": true,
            "capabilities": {
              "drop": ["ALL"]
            }
          },
          "resources": {
            "requests": {
              "cpu": "100m",
              "memory": "256Mi",
              "ephemeral-storage": "256Mi"
            },
            "limits": {
              "cpu": "500m",
              "memory": "512Mi",
              "ephemeral-storage": "3Gi"
            }
          },
          "volumeMounts": [
            {
              "name": "script",
              "mountPath": "/scripts",
              "readOnly": true
            },
            {
              "name": "work",
              "mountPath": "/work"
            },
            {
              "name": "tmp",
              "mountPath": "/tmp"
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "script",
          "configMap": {
            "name": "postgres-backup-s3-script",
            "defaultMode": 292
          }
        },
        {
          "name": "work",
          "emptyDir": {
            "sizeLimit": "2Gi"
          }
        },
        {
          "name": "tmp",
          "emptyDir": {
            "sizeLimit": "128Mi"
          }
        }
      ]
    }
  }
}
