FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS bun
FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY . .
RUN bun install --frozen-lockfile
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_SENTRY_DSN
RUN bun run --filter @riftbound/contracts build && bun run --cwd apps/mobile build:web
RUN find apps/mobile/dist -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.json' -o -name '*.svg' -o -name '*.ttf' -o -name '*.otf' \) -exec gzip -k -9 {} +

FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03 AS runtime
COPY --from=build /app/apps/mobile/dist /usr/share/nginx/html
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
# One worker is enough for static files and asynchronous API/SSE proxying.
USER root
RUN sed -i 's/worker_processes  auto;/worker_processes  1;/' /etc/nginx/nginx.conf
USER 101:101
ENV PORT=8080 NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 NGINX_ENVSUBST_FILTER="^(BACKEND_URL|PORT|NGINX_LOCAL_RESOLVERS)$"
EXPOSE 8080
