{
  "name": "astral-grove",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "bun run --cwd apps/api dev",
    "dev:api": "bun run dev:backend",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "deploy:prisma:api": "bunx @prisma/cli@3.0.0-beta.30 app deploy --framework bun --entry apps/api/src/index.ts",
    "cloudflared": "bun scripts/dev-tunnel.mjs",
    "build": "turbo build",
    "lint": "eslint \"apps/**/*.{ts,tsx,js,mjs}\" \"packages/**/*.{ts,tsx,js,mjs}\" \"design/**/*.{ts,tsx,js,mjs}\" --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/.next/**\"",
    "lint:fix": "bun run lint --fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "unused": "knip",
    "unused:exports": "knip --exports --no-config-hints --no-exit-code",
    "dupes": "jscpd --config .jscpd.json .",
    "test": "bun scripts/test.mjs",
    "test:ui-e2e": "bun run --cwd apps/mobile test:ui-e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bun run --filter @riftbound/api db:migrate",
    "db:reset": "bun run --filter @riftbound/api db:reset",
    "db:reset:full": "bun run --filter @riftbound/api db:reset:full",
    "db:generate": "bun run --filter @riftbound/api db:generate",
    "db:studio": "bun run --filter @riftbound/api db:studio",
    "sync:catalog": "curl -s -X POST http://localhost:7000/api/v1/sync/catalog -H \"Authorization: Bearer ${ADMIN_SYNC_TOKEN:-dev-sync-token-change-me}\"",
    "sync:prices": "curl -s -X POST http://localhost:7000/api/v1/sync/prices -H \"Authorization: Bearer ${ADMIN_SYNC_TOKEN:-dev-sync-token-change-me}\"",
    "audit:cards": "bun run --cwd apps/api audit:cards",
    "db:setup": "bun run db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "jscpd": "^5.0.16",
    "knip": "^6.33.0",
    "prettier": "^3.5.3",
    "railway": "^3.11.0",
    "turbo": "^2.5.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "expo": "57.0.13",
    "expo-modules-core": "57.0.11"
  },
  "patchedDependencies": {
    "uniwind@1.10.0": "patches/uniwind@1.10.0.patch"
  }
}
