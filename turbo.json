{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TEST_DB_URL", "NODE_ENV", "ASTRAL_BACKEND_BIN"]
    },
    "@riftbound/api#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@riftbound/api#typecheck": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@riftbound/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    }
  }
}
